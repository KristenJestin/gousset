# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# Production unless a tool says otherwise (`vp dev` sets development, `vp test` test), so that a
# server started by hand never runs with development's relaxed auth.
# @public @type=enum(development, production, test)
NODE_ENV=production

# Optional here so that a clean clone builds without secrets. In production better-auth refuses
# its default secret, and the Compose healthcheck (`/api/auth/ok`) then reports the app unhealthy.
# @required=false @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The defaults below serve local development against `pnpm db:start`. An installation sets its
# own, and DATABASE_URL must carry the same password as POSTGRES_PASSWORD.
# @public @type=url
BETTER_AUTH_URL=http://localhost:3001

# @type=string(minLength=1)
DATABASE_URL=postgresql://postgres:password@localhost:5432/gousset
