# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Optional here so that a clean clone builds and runs; better-auth itself refuses to start in
# production without it, and falls back to a default secret in development.
# @required=false @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The defaults below serve local development against `pnpm db:start`; an installation sets its own.
# @public @type=url
BETTER_AUTH_URL=http://localhost:3001

# @type=string(minLength=1)
DATABASE_URL=postgresql://postgres:password@localhost:5432/gousset
