# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# Production unless a tool says otherwise (`vp dev` sets development, `vp test` test), so that a
# server started by hand never runs with development's relaxed auth.
# @public @type=enum(development, production, test)
NODE_ENV=production

# Optional here so that a clean clone builds without secrets. In production better-auth refuses
# its default secret, and the image's health check (`/health`) then reports the app unhealthy.
# @required=false @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The defaults below serve local development against `pnpm db:start`. An installation sets its
# own: docker-compose.yml gives the image DATABASE_URL without a password and the password apart
# (DATABASE_PASSWORD_FILE), which the image's entry point puts into the URL, encoded.
# @public @type=url
BETTER_AUTH_URL=http://localhost:3001

# The reverse proxy in front of the app, by its address (`192.168.1.2`), or several separated by
# commas. Only a request from one of them has its `X-Forwarded-For` read for the client's address,
# which failed sign-ins are counted against. Empty: no proxy is trusted.
# List the proxies only: any other machine in a listed range can choose the address it is counted
# as. When this is set, the app's port must be reachable only through the proxy, never directly.
# @required=false @sensitive=false @type=string
TRUSTED_PROXIES=

# How many requests the MCP door's authorization endpoint takes from one client address in a
# minute, 30 when empty: each may make the app fetch a client's metadata and write a client before
# anyone signs in, and a person connecting agents makes a few. The end-to-end tests raise it: every
# client of a test worker comes from one address.
# @required=false @sensitive=false @type=number(min=1, isInt=true)
MCP_AUTHORIZE_PER_MINUTE=

# The tables' owner, which runs the migrations. The app logs in as its own role, gousset_app, with
# a password derived from the owner's (packages/db/src/app-role.ts).
# @type=string(minLength=1)
DATABASE_URL=postgresql://postgres:password@localhost:5432/gousset
