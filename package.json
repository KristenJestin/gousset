{
  "name": "gousset",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check": "vp check && vp run -r check-types",
    "check-types": "vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test",
    "e2e": "pnpm --filter @gousset/e2e exec playwright test",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "storybook": "vp run --filter @gousset/ui storybook",
    "build:storybook": "vp run --filter @gousset/ui build-storybook",
    "test:ui": "vp run --filter @gousset/ui test:e2e",
    "db:push": "vp run --filter @gousset/db db:push",
    "db:studio": "vp run --filter @gousset/db db:studio",
    "db:generate": "vp run --filter @gousset/db db:generate",
    "db:migrate": "vp run --filter @gousset/db db:migrate",
    "db:seed": "vp run --filter @gousset/db db:seed",
    "db:start": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:watch": "docker compose -f docker-compose.dev.yml up postgres",
    "db:stop": "docker compose -f docker-compose.dev.yml stop postgres",
    "db:down": "docker compose -f docker-compose.dev.yml down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "i18n:compile": "pnpm --dir packages/i18n run compile",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/ && pnpm --dir packages/i18n run compile",
    "auth:generate": "cd apps/web && pnpm run auth:generate"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.1.0",
    "@gousset/config": "workspace:*",
    "@oxlint/plugins": "1.94.0",
    "@shadcn/lint": "0.2.5",
    "@tanstack/intent": "0.5.6",
    "@types/node": "^26.6.6",
    "react-doctor": "0.9.23",
    "rolldown": "1.3.3",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.21.0",
  "intent": {
    "skills": [
      "@tanstack/react-router",
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@cloudflare/oxlint-config",
      "drizzle-kit",
      "varlock"
    ]
  }
}
