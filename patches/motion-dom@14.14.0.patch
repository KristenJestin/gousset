diff --git a/dist/es/animation/waapi/utils/timeline-lag.mjs b/dist/es/animation/waapi/utils/timeline-lag.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b55139d361ce492c32882378c1b701894d609772
--- /dev/null
+++ b/dist/es/animation/waapi/utils/timeline-lag.mjs
@@ -0,0 +1,20 @@
+import { time } from '../../../frameloop/sync-time.mjs';
+
+/**
+ * Gousset's patch (KristenJestin/gousset#167): how far a WAAPI animation's
+ * timeline reads from Motion's clock (`time.now()`, performance.now() or the
+ * frame's timestamp), in ms. Motion sets WAAPI start times on its own clock;
+ * a start time is read on the animation's timeline. Chromium's document
+ * timeline reads as performance.now(); Firefox's can trail it by seconds
+ * (4.4 s after a reload, in CI), and an animation started on Motion's clock
+ * then waits that long before it moves. A timeline without a time in ms (a
+ * scroll timeline, an inactive one) gives 0: Motion's own handling is kept.
+ */
+function timelineLag(animation) {
+    const timeline = animation.timeline ??
+        (typeof document === "undefined" ? undefined : document.timeline);
+    const current = timeline?.currentTime;
+    return typeof current === "number" ? current - time.now() : 0;
+}
+
+export { timelineLag };
